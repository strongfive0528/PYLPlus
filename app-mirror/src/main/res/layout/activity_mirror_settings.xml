<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceVariant">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:fillViewport="true" android:paddingBottom="100dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="20dp" android:paddingBottom="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="设置" android:textAppearance="@style/TextAppearance.ConnectScreen.Title" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:layout_marginBottom="16dp"
                android:text="连接、显示、输入与声音，按使用场景重新整理。"
                android:textAppearance="@style/TextAppearance.ConnectScreen.Body" />

            <com.google.android.material.button.MaterialButton android:id="@+id/applySettingsButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="28dp" android:text="应用设置并重启服务" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="外观" android:textAppearance="@style/TextAppearance.ConnectScreen.Overline" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="28dp" android:background="@drawable/cs_settings_group" android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="显示模式" android:textAppearance="@style/TextAppearance.ConnectScreen.Section" />
                <Spinner android:id="@+id/appearanceModeSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="连接准备" android:textAppearance="@style/TextAppearance.ConnectScreen.Overline" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="28dp" android:background="@drawable/cs_settings_group" android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="权限状态" android:textAppearance="@style/TextAppearance.ConnectScreen.Section" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shizuku" android:textStyle="bold" />
                        <TextView android:id="@+id/shizukuStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.ConnectScreen.Body" />
                    </LinearLayout>
                    <TextView android:id="@+id/shizukuStatusPrefix" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/shizukuPermissionBtn" style="@style/Widget.ConnectScreen.Button.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="授权" android:visibility="gone" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="?attr/colorSurfaceVariant" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="无障碍服务" android:textStyle="bold" /><TextView android:id="@+id/accessibilityStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.ConnectScreen.Body" /></LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/accessibilityPermissionBtn" style="@style/Widget.ConnectScreen.Button.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="授权" android:visibility="gone" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/disableAccessibilityCheckbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="临时禁用无障碍服务" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="悬浮窗" android:textStyle="bold" /><TextView android:id="@+id/overlayStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.ConnectScreen.Body" /></LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/overlayPermissionBtn" style="@style/Widget.ConnectScreen.Button.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="授权" android:visibility="gone" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="麦克风" android:textStyle="bold" /><TextView android:id="@+id/microphoneStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.ConnectScreen.Body" /></LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/microphonePermissionBtn" style="@style/Widget.ConnectScreen.Button.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="授权" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="投屏体验" android:textAppearance="@style/TextAppearance.ConnectScreen.Overline" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="28dp" android:background="@drawable/cs_settings_group" android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="20dp">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/singleAppModeCheckbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="单应用投屏" />
                <LinearLayout android:id="@+id/singleAppContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:visibility="gone"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="仅选择一个应用投到外接屏幕。" android:textAppearance="@style/TextAppearance.ConnectScreen.Body" /><com.google.android.material.button.MaterialButton android:id="@+id/selectAppButton" style="@style/Widget.ConnectScreen.Button.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="选择应用" android:layout_gravity="center_horizontal" /></LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/autoRotateCheckbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="自动旋转" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="缩放方式" android:textAppearance="@style/TextAppearance.ConnectScreen.Body" />
                <Spinner android:id="@+id/autoScaleModeSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                <LinearLayout android:id="@+id/dpiLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal"><EditText android:id="@+id/dpiEditText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="DPI" android:inputType="number" /><com.google.android.material.button.MaterialButton android:id="@+id/dpiConfirmButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="确定" /></LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/autoScreenOffCheckbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="连接后自动熄屏" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="手柄触发方式" android:textAppearance="@style/TextAppearance.ConnectScreen.Body" />
                <Spinner android:id="@+id/gamepadTriggerModeSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/useBlackImageCheckbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="使用黑色占位图" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="输入与悬浮控制" android:textAppearance="@style/TextAppearance.ConnectScreen.Overline" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="28dp" android:background="@drawable/cs_settings_group" android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="20dp">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/autoBindInputCheckbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="自动绑定输入设备" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/autoMoveImeCheckbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="自动移动输入法" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/useTouchscreenCheckbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="启用触屏控制" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/autoMatchAspectRatioCheckbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="匹配目标屏幕比例" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/showFloatingInMirrorModeCheckbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="镜像模式显示悬浮按钮" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="悬浮按钮样式" android:textAppearance="@style/TextAppearance.ConnectScreen.Body" />
                <Spinner android:id="@+id/floatingButtonModeSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="声音" android:textAppearance="@style/TextAppearance.ConnectScreen.Overline" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="28dp" android:background="@drawable/cs_settings_group" android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="20dp">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/audioOverrideCheckbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="覆盖默认音频输出" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="输出设备" android:textAppearance="@style/TextAppearance.ConnectScreen.Body" />
                <Spinner android:id="@+id/audioDestinationSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="音频采集方式" android:textAppearance="@style/TextAppearance.ConnectScreen.Body" />
                <Spinner android:id="@+id/audioCaptureMethodSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/disableUsbAudioCheckbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="停用外接屏幕音频输出" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="客户端连接" android:textAppearance="@style/TextAppearance.ConnectScreen.Overline" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="28dp" android:background="@drawable/cs_settings_group" android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="20dp">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/autoConnectClientCheckbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="自动连接客户端" />
                <LinearLayout android:id="@+id/clientConnectionContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical"><Spinner android:id="@+id/clientSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" /><com.google.android.material.button.MaterialButton android:id="@+id/connectClientButton" style="@style/Widget.ConnectScreen.Button.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="连接客户端" android:layout_gravity="center_horizontal" /></LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/preventAutoLockCheckbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="投屏时保持唤醒" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="高级" android:textAppearance="@style/TextAppearance.ConnectScreen.Overline" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="20dp" android:background="@drawable/cs_settings_group" android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="分辨率与服务" android:textAppearance="@style/TextAppearance.ConnectScreen.Section" />
                <TextView android:id="@+id/currentResolutionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textAppearance="@style/TextAppearance.ConnectScreen.Body" />
                <com.google.android.material.button.MaterialButton android:id="@+id/resolutionButton" style="@style/Widget.ConnectScreen.Button.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="调整分辨率" android:layout_gravity="center_horizontal" />
                <com.google.android.material.button.MaterialButton android:id="@+id/aboutButton" style="@style/Widget.ConnectScreen.Button.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="关于应用" android:layout_gravity="center_horizontal" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/applySettingsFab"
        android:layout_width="140dp" android:layout_height="72dp" android:layout_gravity="bottom|end"
        android:layout_margin="20dp" android:text="应用" />
</FrameLayout>
