<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="X11Theme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/cs_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cs_primary</item>
        <item name="colorSecondary">@color/cs_accent</item>
        <item name="android:windowBackground">@color/cs_background</item>
        <item name="android:statusBarColor">@color/cs_background</item>
        <item name="android:navigationBarColor">@color/cs_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColorPrimary">@color/cs_text</item>
        <item name="android:textColorSecondary">@color/cs_text_secondary</item>
        <item name="buttonStyle">@style/Widget.ConnectScreen.Button</item>
        <item name="android:buttonStyle">@style/Widget.ConnectScreen.Button</item>
        <item name="switchStyle">@style/Widget.ConnectScreen.Switch</item>
        <item name="spinnerStyle">@style/Widget.ConnectScreen.Spinner</item>
        <item name="editTextStyle">@style/Widget.ConnectScreen.Input</item>
    </style>
    <style name="AppTheme.Teal" parent="AppTheme">
        <item name="colorPrimary">#006C5F</item>
        <item name="colorSecondary">#006E5D</item>
        <item name="colorSurface">#F6FBF8</item>
    </style>
    <style name="AppTheme.Violet" parent="AppTheme">
        <item name="colorPrimary">#6750A4</item>
        <item name="colorSecondary">#7955B4</item>
        <item name="colorSurface">#FAF8FF</item>
    </style>
    <style name="AppTheme.Oled" parent="AppTheme">
        <item name="colorPrimary">#AFCBFF</item>
        <item name="colorSecondary">#B5C7FF</item>
        <item name="colorSurface">#000000</item>
        <item name="colorOnSurface">#E2E2E9</item>
        <item name="colorSurfaceVariant">#1A1C20</item>
        <item name="colorOnSurfaceVariant">#C4C6D0</item>
    </style>

    <style name="Widget.ConnectScreen.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ConnectScreen.Pill</item>
        <item name="rippleColor">?attr/colorPrimaryContainer</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 50% corners: every button renders with fully round (pill) ends regardless of its height. -->
    <style name="ShapeAppearance.ConnectScreen.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="Widget.ConnectScreen.Button.Secondary" parent="Widget.ConnectScreen.Button">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
    </style>
    <style name="Widget.ConnectScreen.Button.Danger" parent="Widget.ConnectScreen.Button">
        <item name="android:textColor">?attr/colorError</item>
        <item name="backgroundTint">?attr/colorErrorContainer</item>
    </style>
    <style name="Widget.ConnectScreen.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/cs_text</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Widget.ConnectScreen.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/cs_spinner</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">48dp</item>
    </style>
    <style name="Widget.ConnectScreen.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/cs_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textColor">@color/cs_text</item>
        <item name="android:textColorHint">@color/cs_text_secondary</item>
    </style>
    <style name="TextAppearance.ConnectScreen.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/cs_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textSize">21sp</item>
    </style>
    <style name="TextAppearance.ConnectScreen.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/cs_text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.ConnectScreen.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/cs_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="TextAppearance.ConnectScreen.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/cs_text_secondary</item>
    </style>
</resources>
